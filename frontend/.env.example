# Base URL of the backend API. Local default is http://localhost:3001.
# In production this is baked into the build:
#   - GitHub Pages: set repo variable VITE_API_URL (see DEPLOY.md), e.g.
#     https://dead-wax-api.onrender.com
VITE_API_URL=http://localhost:3001

# Optional: override the base path Vite builds against.
# Defaults to /E-Commerce_MERN/ for a GitHub Pages project site.
# VITE_BASE=/
